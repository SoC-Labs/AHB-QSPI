#-----------------------------------------------------------------------------
# SoCLabs AHB QSPI — SpyGlass CDC Design Constraints
#
# Defines clock domains, resets, and constant ports for CDC analysis of
# top_ahb_qspi.  Three clock domains:
#
#   hclk_domain   — AHB system clock (bus interface, cache, clock divider)
#   pclk_domain   — APB peripheral clock (register block)
#   qspi_domain   — Generated divided clock from qspi_clock_div
#
# The QSPI serial clock (QSPI_SCLK_i) is generated by dividing HCLK
# inside qspi_clock_div.  When QSPI_CLK_DIV == 0 it passes HCLK through,
# otherwise it produces a slower divided clock.  For CDC analysis we treat
# it as a separate asynchronous domain since the divider ratio is
# software-programmable and the phase relationship is not guaranteed.
#
# ─────────────────────────────────────────────────────────────────────────────
# Waiver strategy (updated after hardware bug hunt in 2026-04):
#
#   The previous version of this file used blanket `quasi_static` waivers
#   on entire APB register words (reg0, reg2, reg3). That hid real CDC
#   vulnerabilities — specifically Bug A (control bus could be corrupted
#   mid-transaction) and Bug D (no recovery from controller wedge after
#   a watchdog fires).
#
#   The RTL has since been hardened:
#     * Control bus (reg2, reg0 fields) latched in QSPI_SCLK_i domain at
#       IDLE->OP transition. No longer relies on software holding the
#       register stable.
#     * WDATA (reg8-11) loaded into QSPI_WDATA_reg at OP entry. Same.
#     * Soft-reset path from AHB watchdog back to controller FSM.
#
#   This file now uses `quasi_static` only where the CDC path genuinely
#   relies on a stable configuration (clock divider, cache setup). Every
#   other crossing either has a proper synchroniser or is protected by
#   downstream latching.
#
# Contributors
#
# David Mapstone (d.a.mapstone@soton.ac.uk)
#
# Copyright 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------

current_design top_ahb_qspi

# ============================================================================
# Clock Definitions
# ============================================================================

# Primary AHB system clock — drives cache_subsystem, ahb_qspi_interface,
# qspi_clock_div counter logic
clock -name HCLK    -domain hclk_domain  -period 10.0

# APB peripheral clock — drives apb_qspi_regs
clock -name PCLK    -domain pclk_domain  -period 10.0

# Generated QSPI serial clock — output of qspi_clock_div, drives
# qspi_controller FSM (posedge and negedge), qspi_controller_mux delay chain
clock -name QSPI_SCLK_i -domain qspi_domain -period 40.0

# ============================================================================
# Reset Definitions
# ============================================================================

reset -name HRESETn  -value 0
reset -name PRESETn  -value 0

# ============================================================================
# Top-Level Input Port Clock Domains
# ============================================================================
# Declare which clock domain drives each top-level input to prevent
# SpyGlass from assigning virtual clocks (SG_VCLK_*) and generating
# false CDC violations.

# AHB subordinate ports — driven by SoC AHB bus (HCLK domain)
abstract_port -ports "HADDR[*]"   -clock HCLK
abstract_port -ports "HTRANS[*]"  -clock HCLK
abstract_port -ports "HWRITE"     -clock HCLK
abstract_port -ports "HSIZE[*]"   -clock HCLK
abstract_port -ports "HBURST[*]"  -clock HCLK
abstract_port -ports "HPROT[*]"   -clock HCLK
abstract_port -ports "HWDATA[*]"  -clock HCLK
abstract_port -ports "HSELx"      -clock HCLK
abstract_port -ports "HREADY"     -clock HCLK

# APB subordinate ports — driven by SoC APB bus (PCLK domain)
abstract_port -ports "PADDR[*]"   -clock PCLK
abstract_port -ports "PPROT[*]"   -clock PCLK
abstract_port -ports "PSEL"       -clock PCLK
abstract_port -ports "PENABLE"    -clock PCLK
abstract_port -ports "PWRITE"     -clock PCLK
abstract_port -ports "PWDATA[*]"  -clock PCLK
abstract_port -ports "PSTRB[*]"   -clock PCLK

# QSPI flash interface — asynchronous external inputs
# QSPI_IO_i is data from the flash device, sampled on QSPI_SCLK_i posedge
abstract_port -ports "QSPI_IO_i[*]" -clock QSPI_SCLK_i

# ============================================================================
# Genuinely Quasi-Static Signals
# ============================================================================
# Only signals that truly cannot change during any QSPI transaction.
# Software guarantees these by convention AND there is no runtime path
# that could modify them (e.g. no AXI arbiter that could reorder writes,
# no spare APB window that software could accidentally hit).
#
# The clock divider value must remain stable because changing it during
# a transaction would corrupt QSPI_SCLK timing. The cache configuration
# similarly must not change mid-access.

# reg13: QSPI_CLK_DIV — clock configuration, changing mid-transaction
# would desynchronise the entire SPI state machine. Convention-protected.
quasi_static -name "u_apb_qspi_regs/reg13[*]"

# reg12: AHB_QSPI_CMD / AHB_QSPI_DUMMY_CYCLES — XiP configuration, written
# once by software and not modified during XiP activity. If software
# violates this, the AHB XiP state machine (ahb_qspi_interface.sv) will
# eventually hit the watchdog timeout (Layer 1 fix) and return HRESP=1
# rather than hang.
quasi_static -name "u_apb_qspi_regs/reg12[*]"

# ============================================================================
# Control Bus — Partially Latched (Bug A fix)
# ============================================================================
# Previously marked quasi_static in bulk — that waiver hid Bug A where
# a mid-transaction SPI_CMD register write could corrupt an active
# transaction. The RTL now latches control signals into QSPI_SCLK_i-domain
# registers at the IDLE->OP transition, so post-ENABLE software writes
# can no longer affect an in-flight transaction.
#
# However, the latching is SINGLE-FLOP, not a full 2-FF synchroniser.
# Metastability is bounded to a narrow window at the IDLE->OP transition:
# if software writes the control register within ~1 HCLK cycle of
# QSPI_enable_sync rising, the first capture flop could be metastable.
# Software must still hold config signals stable for at least 2 HCLK
# cycles before asserting ENABLE (achieved automatically by the standard
# two-write-to-SPI_CMD pattern).
#
# This is a deliberate tradeoff: a full 2-FF sync on the 22-bit address
# plus 128-bit WDATA plus ~15 bits of flags would cost ~165 flops for
# a scenario that the two-write pattern already protects against.
#
# SpyGlass will still flag these paths as unsynchronised. We issue
# targeted cdc_false_path waivers instead of quasi_static, so the
# report clearly shows where the protection lives (the latching regs
# in qspi_controller.sv, not "software convention").

# Control flags — read/write/addr_en/etc. Latched at IDLE->OP transition.
cdc_false_path -from "u_apb_qspi_regs/reg2[*]" -to "u_qspi_controller/qspi_read_latched"
cdc_false_path -from "u_apb_qspi_regs/reg2[*]" -to "u_qspi_controller/qspi_write_latched"
cdc_false_path -from "u_apb_qspi_regs/reg2[*]" -to "u_qspi_controller/qspi_addr_en_latched"
cdc_false_path -from "u_apb_qspi_regs/reg2[*]" -to "u_qspi_controller/qspi_n_rw_bytes_latched[*]"
cdc_false_path -from "u_apb_qspi_regs/reg2[*]" -to "u_qspi_controller/qspi_dummy_cycles_latched[*]"

# CTRL mode bits
cdc_false_path -from "u_apb_qspi_regs/reg0[*]" -to "u_qspi_controller/qspi_qio_mode_latched"
cdc_false_path -from "u_apb_qspi_regs/reg0[*]" -to "u_qspi_controller/qspi_cont_read_latched"
cdc_false_path -from "u_apb_qspi_regs/reg0[*]" -to "u_qspi_controller/qspi_mode_code_latched[*]"
cdc_false_path -from "u_apb_qspi_regs/reg0[*]" -to "u_qspi_controller/qspi_no_cmd_latched"

# Address and WDATA are loaded into op_code/addr_code/QSPI_WDATA_reg by
# the negedge block's IDLE-default branch. Same protection pattern as
# the latching regs above. TODO: add explicit latching regs for ADDR
# and WDATA (low cost, completes the Bug A fix for the data path).
cdc_false_path -from "u_apb_qspi_regs/reg3[*]"  -to "u_qspi_controller/addr_code[*]"
cdc_false_path -from "u_apb_qspi_regs/reg8[*]"  -to "u_qspi_controller/QSPI_WDATA_reg[*]"
cdc_false_path -from "u_apb_qspi_regs/reg9[*]"  -to "u_qspi_controller/QSPI_WDATA_reg[*]"
cdc_false_path -from "u_apb_qspi_regs/reg10[*]" -to "u_qspi_controller/QSPI_WDATA_reg[*]"
cdc_false_path -from "u_apb_qspi_regs/reg11[*]" -to "u_qspi_controller/QSPI_WDATA_reg[*]"

# ============================================================================
# Safe-by-Protocol: QSPI Read Data Path (RDATA, 128 bits)
# ============================================================================
# QSPI_RDATA[127:0] is combinationally derived from data_in_reg in the
# QSPI_SCLK_i domain. The destination interfaces (ahb_qspi_interface in
# HCLK, apb_qspi_regs in PCLK) sample RDATA when their synchronised
# BUSY signal deasserts — which is multiple cycles AFTER the controller
# stops writing data_in_reg.
#
# This is a "valid-qualified" CDC where the valid (BUSY-low) is itself
# properly synchronised. SpyGlass needs the cdc_false_path directive
# because the data bus itself has no per-bit sync — correct by design,
# not by waiver.
#
# Caveat: if CLK_DIV is very low (0 or 1), the stability window between
# the controller stopping writes and BUSY dropping shrinks. Covered by
# test_cdc_rdata_stability_at_low_clkdiv; if that test ever fails, add
# explicit handshake logic instead of this cdc_false_path.
cdc_false_path -from "u_qspi_controller/data_in_reg[*]" -to "u_ahb_qspi_interface/HRDATA[*]"
cdc_false_path -from "u_qspi_controller/data_in_reg[*]" -to "u_apb_qspi_regs/PRDATA[*]"

# ============================================================================
# Reset Domain Crossing: HRESETn in QSPI_SCLK_i domain
# ============================================================================
# QSPI_SCLK_i is generated by dividing HCLK inside qspi_clock_div. When
# QSPI_CLK_DIV > 0, QSPI_SCLK_i rising edges are aligned to HCLK rising
# edges, so HRESETn deassertion (synchronous to HCLK) is deterministic
# relative to QSPI_SCLK_i. When QSPI_CLK_DIV == 0, QSPI_SCLK_i IS HCLK.
# No reset synchronizer is needed — this is a legitimate false path.
cdc_false_path -from HRESETn -to "u_qspi_controller_mux/AHB_QSPI_BUSY_del"
cdc_false_path -from HRESETn -to "u_qspi_controller_mux/AHB_QSPI_BUSY_del1"
cdc_false_path -from HRESETn -to "u_qspi_controller_mux/AHB_QSPI_BUSY_del2"

# ============================================================================
# SOFT_RESET (new, from AHB watchdog to QSPI controller)
# ============================================================================
# The AHB watchdog in ahb_qspi_interface drives SOFT_RESET (HCLK domain)
# into qspi_controller (QSPI_SCLK_i domain). The controller has its own
# 2-FF synchroniser (soft_reset_sync_meta, soft_reset_sync) so SpyGlass
# should recognise this as a synchronous reset crossing with proper
# synchronisation. No waiver needed, but documented here.

# ============================================================================
# CDC Fix Status
# ============================================================================
# 1. QSPI_ENABLE: 2-FF sync in qspi_controller.sv (FIXED)
# 2. QSPI_ENABLE_ACK: 2-FF sync in apb_qspi_regs (PCLK) and
#    ahb_qspi_interface (HCLK) (FIXED)
# 3. QSPI_BUSY: 2-FF sync in apb_qspi_regs (PCLK) and ahb_qspi_interface
#    (HCLK) (FIXED)
# 4. QSPI_RDATA: safe-by-protocol with BUSY qualifier (cdc_false_path
#    explicit above)
# 5. Config registers (CMD, ADDR, WDATA, etc.): now LATCHED in the
#    QSPI_SCLK_i domain at OP entry (FIXED, previously relied on
#    quasi_static convention)
# 6. SOFT_RESET (watchdog to controller): 2-FF sync in qspi_controller.sv
#    (FIXED, new crossing added to support Layer 1 watchdog recovery)
