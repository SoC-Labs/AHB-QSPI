#-----------------------------------------------------------------------------
# SoCLabs AHB QSPI — SpyGlass CDC Design Constraints
#
# Defines clock domains, resets, and constant ports for CDC analysis of
# top_ahb_qspi.  Three clock domains:
#
#   hclk_domain   — AHB system clock (bus interface, cache, clock divider)
#   pclk_domain   — APB peripheral clock (register block)
#   qspi_domain   — Generated divided clock from qspi_clock_div
#
# The QSPI serial clock (QSPI_SCLK_i) is generated by dividing HCLK
# inside qspi_clock_div.  When QSPI_CLK_DIV == 0 it passes HCLK through,
# otherwise it produces a slower divided clock.  For CDC analysis we treat
# it as a separate asynchronous domain since the divider ratio is
# software-programmable and the phase relationship is not guaranteed.
#
# Contributors
#
# David Mapstone (d.a.mapstone@soton.ac.uk)
#
# Copyright 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------

current_design top_ahb_qspi

# ============================================================================
# Clock Definitions
# ============================================================================

# Primary AHB system clock — drives cache_subsystem, ahb_qspi_interface,
# qspi_clock_div counter logic
clock -name HCLK    -domain hclk_domain  -period 10.0

# APB peripheral clock — drives apb_qspi_regs
clock -name PCLK    -domain pclk_domain  -period 10.0

# Generated QSPI serial clock — output of qspi_clock_div, drives
# qspi_controller FSM (posedge and negedge), qspi_controller_mux delay chain
clock -name QSPI_SCLK_i -domain qspi_domain -period 40.0

# ============================================================================
# Reset Definitions
# ============================================================================

reset -name HRESETn  -value 0
reset -name PRESETn  -value 0

# ============================================================================
# Top-Level Input Port Clock Domains
# ============================================================================
# Declare which clock domain drives each top-level input to prevent
# SpyGlass from assigning virtual clocks (SG_VCLK_*) and generating
# false CDC violations.

# AHB subordinate ports — driven by SoC AHB bus (HCLK domain)
abstract_port -ports "HADDR[*]"   -clock HCLK
abstract_port -ports "HTRANS[*]"  -clock HCLK
abstract_port -ports "HWRITE"     -clock HCLK
abstract_port -ports "HSIZE[*]"   -clock HCLK
abstract_port -ports "HBURST[*]"  -clock HCLK
abstract_port -ports "HPROT[*]"   -clock HCLK
abstract_port -ports "HWDATA[*]"  -clock HCLK
abstract_port -ports "HSELx"      -clock HCLK
abstract_port -ports "HREADY"     -clock HCLK

# APB subordinate ports — driven by SoC APB bus (PCLK domain)
abstract_port -ports "PADDR[*]"   -clock PCLK
abstract_port -ports "PPROT[*]"   -clock PCLK
abstract_port -ports "PSEL"       -clock PCLK
abstract_port -ports "PENABLE"    -clock PCLK
abstract_port -ports "PWRITE"     -clock PCLK
abstract_port -ports "PWDATA[*]"  -clock PCLK
abstract_port -ports "PSTRB[*]"   -clock PCLK

# QSPI flash interface — asynchronous external inputs
# QSPI_IO_i is data from the flash device, sampled on QSPI_SCLK_i posedge
abstract_port -ports "QSPI_IO_i[*]" -clock QSPI_SCLK_i

# ============================================================================
# Quasi-Static Configuration Signals
# ============================================================================
# These signals are written by software via APB registers and are stable
# during any QSPI transaction.  Software must not change them while
# QSPI_BUSY is asserted.  Marking them quasi_static suppresses false
# CDC violations for these configuration paths.

# From apb_qspi_regs (PCLK domain) used by qspi_controller (QSPI_SCLK_i domain)
quasi_static -name "u_apb_qspi_regs/reg0[*]"
quasi_static -name "u_apb_qspi_regs/reg12[*]"
quasi_static -name "u_apb_qspi_regs/reg13[*]"

# ============================================================================
# Notes on Known CDC Paths
# ============================================================================
#
# 1. QSPI_ENABLE (HCLK/PCLK -> QSPI_SCLK_i)
#    In qspi_controller.sv, QSPI_ENABLE is synchronised with a single FF
#    (QSPI_enable_sync).  This is a KNOWN BUG — a single-stage synchroniser
#    does not protect against metastability.  SpyGlass should flag this as
#    Ac_unsync01 or Ac_sync01a (insufficient synchronisation depth).
#    FIX: Add a second synchroniser stage.
#
# 2. QSPI_ENABLE_ACK (QSPI_SCLK_i -> HCLK/PCLK)
#    Combinationally derived from qspi_controller FSM state (QSPI_SCLK_i
#    domain), consumed by apb_qspi_regs (PCLK) and ahb_qspi_interface
#    (HCLK) with NO synchronisation.  SpyGlass will flag Ac_unsync01.
#
# 3. QSPI_RDATA[127:0] (QSPI_SCLK_i -> HCLK/PCLK)
#    128-bit read data from qspi_controller, combinationally derived from
#    data_in_reg (QSPI_SCLK_i domain).  Used by ahb_qspi_interface (HCLK)
#    and apb_qspi_regs (PCLK) without synchronisation.
#    In practice, data is stable before QSPI_BUSY deasserts, but the
#    protocol handshake itself (QSPI_BUSY) is also unsynchronised.
#
# 4. QSPI_BUSY / QSPI_nCS (QSPI_SCLK_i -> HCLK/PCLK)
#    QSPI_nCS is derived from QSPI_SCLK_i-domain signals.  It feeds back
#    as QSPI_BUSY to apb_qspi_regs (PCLK) and ahb_qspi_interface (HCLK)
#    through qspi_controller_mux — without synchronisation.
#
# 5. QSPI_CMD, QSPI_READ, QSPI_WRITE, QSPI_ADDR, etc.
#    (HCLK/PCLK -> QSPI_SCLK_i via qspi_controller_mux)
#    These control/data signals cross from HCLK or PCLK domain into the
#    QSPI_SCLK_i domain.  They are sampled by qspi_controller on the
#    posedge/negedge of QSPI_SCLK_i.  The design relies on them being
#    stable when QSPI_ENABLE is asserted, but there is no hardware
#    synchronisation.
