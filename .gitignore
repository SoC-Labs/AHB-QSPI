# ── ASIC: Fusion Compiler + Formality flows under syn/asic/ ───────────────
# Shared invariant: track Makefiles + scripts/ + inputs/ only; everything
# regenerable (work libs, logs, reports, NDM ref-libs, generated outputs,
# fc_shell/lm_shell scratch) is ignored.
syn/asic/*/work/
syn/asic/*/logs/
syn/asic/*/reports/

# Fusion Compiler-specific scratch + deliverables
syn/asic/fusion-compiler/libs/
syn/asic/fusion-compiler/outputs/
syn/asic/fusion-compiler/PreFrameCheck/
syn/asic/fusion-compiler/check_workspace.ems
syn/asic/fusion-compiler/lm_command.log
syn/asic/fusion-compiler/lm_output.txt
syn/asic/fusion-compiler/*.svf
syn/asic/fusion-compiler/alib-*
syn/asic/fusion-compiler/.synopsys*

# Locally-generated FF .db files (built by `make mem_ff_db`)
syn/asic/libs/

# Formality-specific scratch
syn/asic/formality/fm_shell_command.log
syn/asic/formality/*.svf

